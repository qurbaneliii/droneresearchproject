        function filterModels() {
            const brand = document.getElementById('filterBrand').value;
            const capacity = document.getElementById('filterCapacity').value;
            const query = document.getElementById('modelSearch').value.toLowerCase();

            const filtered = modelsData.filter(m => {
                const matchBrand = !brand || m.brand === brand;
                const matchQuery = !query || m.name.toLowerCase().includes(query) || m.brand.toLowerCase().includes(query);
                
                let matchCap = true;
                const tankNum = parseInt(m.tank);
                if (capacity === 'heavy') matchCap = tankNum >= 50;
                else if (capacity === 'medium') matchCap = tankNum >= 20 && tankNum < 50;
                else if (capacity === 'light') matchCap = tankNum < 20;

                return matchBrand && matchQuery && matchCap;
            });

            renderModelsTable(filtered);
        }

