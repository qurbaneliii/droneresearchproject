                note = "Dağlıq meyvə bağlarında 3D Lidar naviqasiyası və incə dumanlandırma (Bimodal Mist) ucluqları kritikdir. Koaksial rotorların yaratdığı aşağıya doğru güclü hava axını (downwash) dərmanı ağac çətirinin alt qatlarına nüfuz etdirir.";
            } else if (terrain === 'multi') {
                recModels = "XAG P150 Max (RevoSling və RevoCast ilə), DJI T100";
                haPerHour = 22;
                note = "Bimodal çiləmə, vintli bərk yayım və RevoSling daşıma modulları ilə tək bir güc bloku üzərindən mövsümi işləri icra etmək mümkündür.";
            } else {
                recModels = "Qifei A22 RTK, Huida HD540 Pro, Joyance JT50";
                haPerHour = 14;
                note = "Büdcəyə həssas təsərrüfatlar üçün kapital xərclərini (CAPEX) $9,000 - $12,000 civarında saxlamaqla təməl hava bitki mühafizəsini təmin edir.";
            }

            const totalHoursNeeded = (size / haPerHour).toFixed(1);
            const flightsNeeded = Math.ceil(size / 3); // ~3 ha per flight avg

            document.getElementById('resModels').innerText = recModels;
            document.getElementById('resFlights').innerText = `~${flightsNeeded} uçuş / ${totalHoursNeeded} saat əməliyyat`;
            document.getElementById('resTime').innerText = `${(totalHoursNeeded / hours).toFixed(1)} gün (${hours} saat/gün rejimi ilə)`;
            document.getElementById('resNote').innerHTML = `<span class="font-bold text-white">Aqronomik Tövsiyə:</span> ${note}`;

            document.getElementById('wizardResult').classList.remove('hidden');
        }

        // GLOSSARY LOGIC
        function renderGlossary(data = glossaryTerms) {
            const grid = document.getElementById('glossaryGrid');
            grid.innerHTML = data.map(g => `
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-2">
                    <h4 class="font-bold text-slate-900 text-sm flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-brand-500"></span>
                        <span>${g.term}</span>
                    </h4>
                    <p class="text-xs text-slate-600 leading-relaxed">${g.desc}</p>
                </div>
            `).join('');
        }

        function filterGlossary() {
            const query = document.getElementById('glossarySearch').value.toLowerCase();
            const filtered = glossaryTerms.filter(g => 
                g.term.toLowerCase().includes(query) || 
                g.desc.toLowerCase().includes(query)
            );
            renderGlossary(filtered);
        }
    </script>
</body>
</html>